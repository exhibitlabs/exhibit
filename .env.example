# Copy to .env.local. Everything is optional. With nothing set, Exhibit runs on the PayPal simulator,
# and the agent runs live on your Claude CLI login. With no Claude CLI either, it replays recorded runs.

# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the app's Sandbox Webhooks section (needed to verify signatures)
PAYPAL_WEBHOOK_ID=

# Run the agent on the Claude API instead of the Claude CLI
ANTHROPIC_API_KEY=
# EXHIBIT_MODEL=claude-opus-5-5

# Public URL of this app (shown as the webhook listener in Settings)
# EXHIBIT_APP_URL=https://your-host.example

# EXHIBIT_ALLOW_CLAUDE_CODE=0   # ignore the local Claude CLI login and replay recorded runs
# EXHIBIT_AI_PROVIDER=replay    # force a provider: anthropic, claude-code or replay
# EXHIBIT_RECORD_REPLAYS=1      # development: save live runs to replays/
